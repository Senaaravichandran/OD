# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# local copy of Vercel env vars (contains secrets)
env.download

# local tooling / generated reports
.claude/
mobile/android/build/

# Supabase CLI scratch state (machine-local, references the linked project)
supabase/.temp/

# Firebase Admin service account - full project access, never commit
firebase-admin*.json
*-firebase-adminsdk-*.json

# The Android app is published on GitHub Releases, not through the site.
# A 60 MB binary in public/ is copied into every single deployment, which is
# how this project reached six gigabytes of deployment storage. next.config.mjs
# redirects /downloads/smvec-od.apk to the release, so the address on the
# posters still works.
public/downloads/*.apk
public/*.apk
